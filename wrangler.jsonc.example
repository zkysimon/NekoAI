{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nekoai-api",
  "main": "src/index.js",
  "compatibility_date": "2026-04-21",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // 可选：非敏感变量（密钥请用 `wrangler secret put` 配置）
  "vars": {
    "EXA_BASE_URL": "https://api.exa.ai",
    "EXA_SEARCH_PATH": "/search",
    "MAX_TOKENS": "8192"
  }

  // 可选：绑定自定义域名（改成自己的域名后再取消注释）
  // "routes": [
  //   { "pattern": "nekoai-api.yourdomain.com", "custom_domain": true }
  // ]
}
